---
import Shell from '../layouts/Shell.astro'
---

<Shell page="success" title="Sent" description="Message sent. Thanks for getting in touch." noindex>
  <section class="phead glow-zone">
    <div class="wrap">
      <p class="prompt" aria-hidden="true">sammy@ibeh:~/contact$ <b>./contact</b></p>
      <h1 aria-label="Message sent"><span class="num" aria-hidden="true">✓</span><span class="t" aria-hidden="true">Message sent</span></h1>
      <p class="sub">Thanks for getting in touch. I’ll reply to the email you gave me. Talk soon.</p>
      <div class="ctas"><a class="btn" href="/">cd ~</a><a class="btn ghost" href="/experience/">cd ~/experience</a></div>
    </div>
  </section>
</Shell>
