<Shell page="privacy" title="Privacy" description="Privacy on sammyibeh.dev: no cookies or tracking, cookieless visit stats, and what happens to contact form messages.">
  <section class="phead glow-zone">
    <div class="wrap">
      <p class="prompt" aria-hidden="true">sammy@ibeh:~$ <b>cat privacy.md</b></p>
      <h1>Privacy</h1>
      <p class="sub">No cookies or tracking. Anonymous, cookieless visit stats via Cloudflare Web Analytics.</p>
