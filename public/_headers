# HTML keeps Netlify's default (public, max-age=0, must-revalidate): the edge caches it and purges on deploy.
# Don't set Cache-Control on /* here: Netlify merges duplicate headers from overlapping rules.
# {inline-script-hashes} is filled in after the build by scripts/csp.mjs.
# The CSP is Report-Only for now: check the console on production (Cloudflare injects scripts there), then rename it to Content-Security-Policy.
# The Apple hosts are for MusicKit on /music-auth/. They sit in the site-wide policy because Netlify merges headers from overlapping rules,
# so a second policy on /music-auth/* would be enforced alongside this one rather than replacing it. Sign-in itself opens a popup, which CSP doesn't govern.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' {inline-script-hashes} https://static.cloudflareinsights.com https://js-cdn.music.apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://api.music.apple.com https://js-cdn.music.apple.com; frame-src https://authorize.music.apple.com; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Content-hashed by Astro, so safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed: give a font file a new name if its contents ever change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js   # retired Gatsby service worker, now a self-unregistering stub
Cache-Control: no-cache

/music-auth/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, no-transform
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
